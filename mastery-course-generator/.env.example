# =============================================================================
# KLAXO production/development configuration
# =============================================================================
# Copy to `.env` and keep real secrets out of source control.

# --- AI -----------------------------------------------------------------------
FCC_SERVER_BASE_URL="https://integrate.api.nvidia.com/v1"
FCC_SERVER_API_KEY=""
NVIDIA_NIM_MODEL="nvidia/nemotron-3-super-120b-a12b"
NVIDIA_NIM_VISION_MODEL="meta/llama-3.2-90b-vision-instruct"
NVIDIA_NIM_EMBEDDING_MODEL="nvidia/nv-embedqa-mistral-7b-v2"
NIM_MODEL_PLANNING=""
NIM_MODEL_GENERATION=""
NIM_MODEL_ASSESSMENT=""
NIM_MODEL_QA=""
NIM_ENABLE_EMBEDDINGS="false"

AI_MAX_RETRIES="3"
AI_REQUEST_TIMEOUT_MS="120000"
AI_MAX_TOKENS="4096"
AI_TEMPERATURE="0.3"
AI_MIN_REQUEST_INTERVAL_MS="2000"
AI_MAX_CONCURRENCY="2"
AI_DEV_MODE="true"

# --- Database / storage -------------------------------------------------------
# Development and the current production worker use SQLite on a persistent
# volume. Do not place this file on ephemeral storage.
DATABASE_FILE="./data/mastery.db"
DATABASE_BUSY_TIMEOUT_MS="10000"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="10485760"
MAX_UPLOAD_FILES="10"

# --- Worker -------------------------------------------------------------------
# Increase carefully according to AI provider quota and host capacity.
WORKER_CONCURRENCY="2"
WORKER_POLL_MS="1500"

# --- Security -----------------------------------------------------------------
# In production, this must be a random 32+ character secret.
APP_SECRET="change-me-please-generate-a-random-32-byte-secret"
RATE_LIMIT_PER_MINUTE="20"

# --- Logging ------------------------------------------------------------------
LOG_LEVEL="info"
LOG_SOURCE_PREVIEWS="false"

# Production requirements:
#   NODE_ENV=production
#   AI_DEV_MODE=false
#   FCC_SERVER_API_KEY=<real server-side key>
#   APP_SECRET=<strong random secret>
